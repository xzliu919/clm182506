% =============================================================================
%  论文列表 / Publications
%  -----------------------------------------------------------------------------
%  在下面添加 BibTeX 条目，al-folio 会自动渲染到 publications 页面。
%  最省事的获取方式：Google Scholar → 某篇论文 → 引用 → BibTeX → 粘贴进来。
%
%  可选字段（会渲染成标签/按钮）：
%    abbr = {PCE}            左侧期刊缩写
%    selected = {true}       首页 “Selected Papers” 中突出显示
%    bibtex_show = {true}    显示 BibTeX 按钮
%    doi / html / pdf / code / poster / slides / video / website = {链接}
%    preview = {xxx.png}     缩略图（放到 assets/img/publication_preview/）
%
%  下面是一个【示例条目】，用你自己的论文替换即可（删掉注释或改写）。
% =============================================================================

% @article{yourkey2025,
%   abbr        = {J. Example},
%   title       = {Your paper title here},
%   author      = {Your, Name and Coauthor, Someone},
%   journal     = {Journal Name},
%   year        = {2025},
%   doi         = {10.xxxx/xxxxx},
%   selected    = {true},
%   bibtex_show = {true}
% }
